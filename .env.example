# ---------------------------------------------------------------- Supabase
# Project URL and anon key from Supabase Console -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ---------------------------------------------------------------- Appwrite
# Console → your project → Settings. The endpoint is the API endpoint, not the
# console URL.
NEXT_PUBLIC_APPWRITE_ENDPOINT=https://fra.cloud.appwrite.io/v1
NEXT_PUBLIC_APPWRITE_PROJECT_ID=

# Server-only API key. Needs scopes: databases.write, tables.write,
# rows.read, rows.write. Never expose this to the browser.
APPWRITE_API_KEY=

# Created by `npm run setup:appwrite`. Leave as-is unless you renamed them.
APPWRITE_DATABASE_ID=appshop
APPWRITE_APPS_TABLE_ID=apps
APPWRITE_PROFILES_TABLE_ID=profiles

# ------------------------------------------------------------------ GitHub
# Optional but strongly recommended. Unauthenticated GitHub API calls are capped
# at 60/hour per IP, which one page of the store can burn through. A fine-grained
# token with public read access lifts that to 5,000/hour.
GITHUB_TOKEN=

# ------------------------------------------------------------------- Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
